    "def clasificar_desempeno(puntaje):\n",
    "    if puntaje < promedio_nacional * 0.9:\n",
    "        return 0  # bajo\n",
    "    elif puntaje < promedio_nacional * 1.1:\n",
    "        return 1  # medio\n",
    "    else:\n",
    "        return 2  # alto\n",
    "\n",
    "df['desempeno'] = df['punt_global'].apply(clasificar_desempeno)"
   ]
